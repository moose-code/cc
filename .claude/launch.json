{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev:local"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "indexer",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd indexer && npx ponder dev --port 42169"
      ],
      "env": {
        "DATABASE_URL": "postgresql://localhost/cc_indexer_local"
      },
      "port": 42169
    }
  ]
}
