# WalletConnect project id (https://cloud.reown.com). Injected wallets work without it.
NEXT_PUBLIC_WC_PROJECT_ID=

# Mainnet RPC. Falls back to a public endpoint when unset.
NEXT_PUBLIC_RPC_URL=https://eth.drpc.org

# Engine addresses. Leave unset until deploy: the UI then shows sample activity.
# Set CORE_LENS to read live stats, statements and the event feed on-chain.
NEXT_PUBLIC_CORE=
NEXT_PUBLIC_CORE_LENS=
NEXT_PUBLIC_CREDITS=
NEXT_PUBLIC_CC=
NEXT_PUBLIC_ROUTER=

# Block the Core was deployed at (speeds up the log scan for the feed).
NEXT_PUBLIC_DEPLOY_BLOCK=
