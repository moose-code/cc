# WalletConnect project id (https://cloud.reown.com). Injected wallets work without it.
NEXT_PUBLIC_WC_PROJECT_ID=

# Mainnet RPC. Falls back to a public endpoint when unset.
NEXT_PUBLIC_RPC_URL=https://eth.drpc.org

# The Core. Unset until launch: the engine pages then show "engine not deployed".
# The controller, the coin and the balance module are read from it.
NEXT_PUBLIC_CORE=

# Block the Core was deployed at (start of the event scan).
NEXT_PUBLIC_DEPLOY_BLOCK=

# The indexer (docs/INDEXER.md). History, lists and slow-moving state come from it; unset, the pages show live
# state and mark history as unavailable. `npm run dev:local` writes http://localhost:42169.
NEXT_PUBLIC_INDEXER_URL=

# The listing adapters the Core allows (deployment record keys strategyAdapter and seaportAdapter). The header
# acquire button needs them; unset, it stays hidden.
NEXT_PUBLIC_STRATEGY_ADAPTER=
NEXT_PUBLIC_SEAPORT_ADAPTER=

# Server only: OpenSea API key for app/api/listings (OpenSea listings of the Credits collection). Unset, only
# CreditStrategy listings are offered.
OPENSEA_API_KEY=

# The coin/eth v4 pool. Defaults are the mainnet launch params; the local record sets them.
# NEXT_PUBLIC_POOL_HOOK, NEXT_PUBLIC_POOL_FEE, NEXT_PUBLIC_POOL_TICK_SPACING

# Local anvil mode is written by `npm run dev:local` into .env.local:
# NEXT_PUBLIC_CHAIN_ID=31337 and NEXT_PUBLIC_LOCAL_ACCOUNTS (a json object of name to address).
