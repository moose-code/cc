# WalletConnect project id (https://cloud.reown.com). Injected wallets work without it.
NEXT_PUBLIC_WC_PROJECT_ID=

# Server only. Keep unset while /exchange is private: production and deploy previews return 404.
# Local next dev remains available. Publication requires a separate explicit owner decision.
# EXCHANGE_ENABLED=true

# Server only. Keep unset while /claim (the $CC burn) is private: production and deploy previews render a "not open
# yet" notice. Local next dev remains available. Opening it follows the owner's stage D decision.
# CLAIM_ENABLED=true

# Server-only optional Tenderly endpoint. Mainnet browsers always read through /api/rpc.
# RPC_URL=
# NEXT_PUBLIC_RPC_URL is used only for local Anvil forks.

# Public origin of the site, for absolute og:image and canonical urls. Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# The Core. Unset until launch: the engine pages then show "engine not deployed".
# The controller, the coin and the balance module are read from it.
NEXT_PUBLIC_CORE=

# Block the Core was deployed at (start of the event scan).
NEXT_PUBLIC_DEPLOY_BLOCK=

# The indexer (docs/INDEXER.md). History, lists and slow-moving state come from it; unset, the pages show live
# state and mark history as unavailable. `npm run dev:local` writes http://localhost:42169.
NEXT_PUBLIC_INDEXER_URL=

# The listing adapters the Core allows (deployment record keys strategyAdapter and seaportAdapter). The header
# acquire button needs them; unset, it stays hidden.
NEXT_PUBLIC_STRATEGY_ADAPTER=
NEXT_PUBLIC_SEAPORT_ADAPTER=

# Server only: the keeper's read-only market view (docs/RUNBOOK.md section 8, MARKET_VIEW_PORT) that app/api/listings
# serves as the OpenSea listings. https, or http on localhost for a local keeper. Unset, the listings surfaces say
# OpenSea listings are not configured and offer CreditStrategy listings only. The token is the keeper's
# MARKET_VIEW_TOKEN when one is set.
KEEPER_MARKET_URL=
KEEPER_MARKET_TOKEN=

# Optional CC pool checks against the configured Core's immutable hook, fee and tick spacing.
# Set them from the verified deployment record; a mismatch disables the CC swap panel.
# NEXT_PUBLIC_POOL_HOOK, NEXT_PUBLIC_POOL_FEE, NEXT_PUBLIC_POOL_TICK_SPACING

# Local anvil mode is written by `npm run dev:local` into .env.local:
# NEXT_PUBLIC_CHAIN_ID=31337 and NEXT_PUBLIC_LOCAL_ACCOUNTS (a json object of name to address).
