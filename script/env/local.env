# values-only environment for `script/deploy.sh local`. no secrets here.
# the local anvil fork deploy path. the signer is the real v2 factory owner,
# impersonated on the fork (anvil --auto-impersonate), so there is no key.
CHAIN_ID=31337
# refuses to broadcast for env local unless this host is 127.0.0.1 or localhost
RPC_URL=http://127.0.0.1:8545
LAUNCH_CONFIG=script/config/anvil.json
# unlocked: forge sends from impersonated accounts via eth_sendTransaction
WALLET_MODE=unlocked
# the deployer is the v2 factory owner (the only sender the factory onlyOwner
# path and Deploy._requireOwner accept). funded by the wrapper via anvil_setBalance
DEPLOYER=0xCB43078C32423F5348Cab5885911C3B5faE217F9
VERIFY=0
# 0: the wrapper does not require the main branch
MAIN_BRANCH_GUARD=0
