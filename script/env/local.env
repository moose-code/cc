# values for `script/deploy.sh local`: the anvil fork of mainnet. the signer is the v2 factory owner, impersonated on the
# node (anvil --auto-impersonate, forge --unlocked). RPC_URL in the shell overrides RPC_URL here.
NODE=anvil
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
LAUNCH_CONFIG=script/config/anvil.json
DEPLOYER=0xCB43078C32423F5348Cab5885911C3B5faE217F9
WALLET=unlocked
SEND_RPC_VAR=
VERIFY=0
GIT_GUARD=0
SIGNOFF=0
