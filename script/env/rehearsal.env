# values for `script/deploy.sh rehearsal`: the mainnet launch on an anvil fork of the latest block, with the launch
# config file, the signoff guard and the git guards of mainnet. start the node first:
#   anvil --fork-url <mainnet rpc> --chain-id 31337 --port 8600 --auto-impersonate --retries 10 --timeout 60000
# RPC_URL in the shell overrides RPC_URL here. the record goes to RECORD_FILE, not to deployments/31337.json.
NODE=anvil
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8600
LAUNCH_CONFIG=script/config/local.json
DEPLOYER=0xCB43078C32423F5348Cab5885911C3B5faE217F9
WALLET=unlocked
SEND_RPC_VAR=
VERIFY=0
GIT_GUARD=1
SIGNOFF=1
RECORD_FILE=deployments/rehearsal.json
