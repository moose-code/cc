# values-only environment for `script/deploy.sh mainnet`. no secrets here.
# required values ship empty so the wrapper refuses until the owner fills them.
# this file does not replace docs/DEPLOY.md: the mainnet launch still signs from
# the owner's own wallet (--ledger or --account) and follows the runbook. the
# wrapper only runs the identical build, preflight, deploy, resume and postflight
# path, it does not decide the launch parameters.
CHAIN_ID=1
# an archive-capable mainnet broadcast rpc (a private relay per docs/DEPLOY.md). empty: wrapper refuses
RPC_URL=
# the gitignored real config copied from script/config/mainnet.json with the real image and description filled
LAUNCH_CONFIG=script/config/local.json
# account or ledger. the signer comes from the wallet flags, never from a key in a file. empty: wrapper refuses
WALLET_MODE=
# the foundry keystore account name used with --account (WALLET_MODE=account). empty: wrapper refuses
WALLET_ACCOUNT=
# the v2 factory owner and config owner. empty: wrapper refuses
DEPLOYER=
VERIFY=1
# 1: the wrapper requires the main branch and a clean tree before it broadcasts
MAIN_BRANCH_GUARD=1
