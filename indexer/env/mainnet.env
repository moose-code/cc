# values for `indexer/deploy.sh mainnet`. Requires deployments/1.json. DATABASE_URL is a Fly secret.
CHAIN_ID=1
TARGET=fly
FLY_CONFIG=fly.mainnet.toml
DATABASE_SCHEMA=cc_mainnet_v9
# Active schema served at the public URL. Views over DATABASE_SCHEMA are created once the backfill is ready.
VIEWS_SCHEMA=cc_mainnet
# Collection deploy blocks (deployment receipts of the Credits and Statements contracts).
CREDITS_START_BLOCK=26037292
STATEMENTS_START_BLOCK=26100733
# CreditStrategy proxy deploy block (first code at 26037623, found by bisecting eth_getCode).
STRATEGY_START_BLOCK=26037623
# Requests per second per public endpoint, in the order of docs/INDEXER.md section 7.1.
RPC_RPS=4,8,5,10,5,5
PONDER_POLL_INTERVAL_MS=12000
PONDER_ETH_GETLOGS_BLOCK_RANGE=5000
SNAPSHOT_INTERVAL_BLOCKS=300
