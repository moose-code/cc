# Copy to .env.local. Values are read by ponder.config.ts; the deployment record (DEPLOYMENT_RECORD) supplies
# addresses and the Core deploy block.
CHAIN_ID=31337
DEPLOYMENT_RECORD=../deployments/31337.json
# Local chain only: the record's rpcUrl is used when unset.
# RPC_URL=http://127.0.0.1:8545
# Directory for PGlite (local only). A real chain requires DATABASE_URL.
# PONDER_DATABASE_DIR=.ponder/pglite
# DATABASE_URL=postgres://user:password@host:5432/db
# Collection deploy blocks. Required on chain 1.
# CREDITS_START_BLOCK=
# STATEMENTS_START_BLOCK=
# CreditStrategy deploy block. Required on chain 1 (26037623); a local fork defaults to 60000 blocks before the Core deploy block.
# STRATEGY_START_BLOCK=
# Requests per second per public endpoint, in list order (docs/INDEXER.md section 7.1).
# RPC_RPS=8,8,5,10,5,5
# Optional paid endpoint appended last; a Fly secret on deployed apps.
# PONDER_RPC_URL_1=
# PONDER_POLL_INTERVAL_MS=12000
# PONDER_ETH_GETLOGS_BLOCK_RANGE=5000
# SNAPSHOT_INTERVAL_BLOCKS=300
